[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/TitleScreen.gd" id="1_title"]
[ext_resource type="AudioStream" path="res://audio/bgm/world.mp3" id="2_title_bgm"]

[sub_resource type="Shader" id="bg_shader"]
code = "shader_type canvas_item;

// 對應 HTML 設計：
// radial-gradient(ellipse 80% 60% at 30% 30%, #2C334D 0%, #1A2138 35%, #0D1019 70%, #0D1019 100%)

void fragment() {
	vec2 center = vec2(0.30, 0.30);
	vec2 radii = vec2(0.80, 0.60);
	vec2 d = (UV - center) / radii;
	float r = length(d);

	vec3 c1 = vec3(0.1725, 0.2000, 0.3020); // #2C334D
	vec3 c2 = vec3(0.1020, 0.1294, 0.2196); // #1A2138
	vec3 c3 = vec3(0.0510, 0.0627, 0.0980); // #0D1019

	vec3 col;
	if (r < 0.35) {
		col = mix(c1, c2, r / 0.35);
	} else if (r < 0.70) {
		col = mix(c2, c3, (r - 0.35) / 0.35);
	} else {
		col = c3;
	}
	COLOR = vec4(col, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="bg_material"]
shader = SubResource("bg_shader")

